  <property>
    <name>dfs.datanode.use.jsvc.allowed</name>
    <value>false</value>
  </property>
  <property>
    <name>ignore.secure.ports.for.testing</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.encrypt.data.transfer</name>
